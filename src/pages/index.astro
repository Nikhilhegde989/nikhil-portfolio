---
import App from '../App.tsx';
import '../App.css';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';

const allPosts = await getCollection('blog');
const blogPosts = allPosts
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    summary: p.data.summary,
    tags: p.data.tags,
    publishedAt: p.data.publishedAt.toISOString(),
    readingTime: p.data.readingTime ?? Math.ceil(readingTime(p.body).minutes),
    thumbnail: p.data.thumbnail,
    featured: p.data.featured,
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/vite.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nikhil Hegde | Backend Engineer</title>
    <meta name="description" content="Backend-focused Software Engineer specializing in Python, FastAPI, PostgreSQL, and distributed systems. Speaker at Hyderabad PG Days 2025." />
    
    <!-- Preload critical assets for LCP -->
    <link rel="preload" as="image" href="/images/profile.webp" type="image/webp" />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CYL1PSW02D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CYL1PSW02D');
    </script>
    <!-- End Google Analytics -->
  </head>
  <body>
    <App client:load blogPosts={blogPosts} />
  </body>
</html>
